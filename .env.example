# Database
DATABASE_URL="postgresql://user:password@localhost:5432/legislation_tracker"
DIRECT_URL="postgresql://user:password@localhost:5432/legislation_tracker" # For migrations

# External APIs
CONGRESS_API_KEY="your_congress_gov_api_key"

# LLM Providers (OpenRouter primary cascade + guarded direct Gemini 3.8 Flash fallback)
OPENROUTER_API_KEYS="your_openrouter_api_key_1,your_openrouter_api_key_2" # Comma-separated keys
OPENROUTER_API_KEY_1="your_openrouter_api_key_1" # Alternative numbered key format (OPENROUTER_API_KEY_1..10)
OPENROUTER_MODELS="deepseek/deepseek-v4.1-flash-1017,xiaomi/mimo-v2.6-flash,z-ai/glm-5.3-flash"
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_FALLBACK_ENABLED="true"
GEMINI_FALLBACK_DAILY_LIMIT="20"
GEMINI_TIMEOUT_MS="60000"
ANTHROPIC_API_KEY="your_anthropic_api_key" # Optional explicit override (AI_MODEL=anthropic)
OPENAI_API_KEY="your_openai_api_key" # Optional explicit override (AI_MODEL=openai)

# Background Workflows & Schedules (Vercel Workflows)
INGEST_LOOKBACK_DAYS="1"
EO_LOOKBACK_DAYS="14"
BILL_TEXT_BATCH_SIZE="10"
EO_TEXT_BATCH_SIZE="10"
SUMMARIZE_BATCH_SIZE="3"
LLM_MAX_ATTEMPTS="5"

# Caching
REDIS_URL="redis://default:password@host:6379"

# Email
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="notifications@yourapp.com"

# Authentication (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret"

# Monitoring
SENTRY_DSN="your_sentry_dsn"
SENTRY_AUTH_TOKEN="your_sentry_token"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
