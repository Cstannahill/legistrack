generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Bill {
  id             String          @id @default(cuid())
  billType       String
  billNumber     Int
  congress       Int
  title          String
  officialTitle  String?
  shortTitle     String?
  introducedDate DateTime
  currentStatus  BillStatus
  statusDate     DateTime
  lawNumber      String?
  fullText       String?
  fullTextUrl    String?
  sponsorId      String?
  sourceUrl      String?
  lastFetchedAt  DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actions        Action[]
  amendments     Amendment[]
  sponsor        Member?         @relation("Sponsored", fields: [sponsorId], references: [id])
  companionOf    CompanionBill[] @relation("CompanionBill")
  companionBills CompanionBill[] @relation("SourceBill")
  summaries      Summary[]
  votes          Vote[]
  categories     Category[]      @relation("BillCategories")
  cosponsors     Member[]        @relation("Cosponsored")
  // Relations
  trackings      BillTracking[]

  @@unique([congress, billType, billNumber])
  @@index([billType, billNumber])
  @@index([currentStatus])
  @@index([introducedDate])
  @@index([introducedDate, id])
  @@index([congress])
}

model CompanionBill {
  id               String        @id @default(cuid())
  sourceBillId     String
  companionBillId  String
  relationshipType CompanionType @default(IDENTICAL)
  verifiedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  companionBill    Bill          @relation("CompanionBill", fields: [companionBillId], references: [id], onDelete: Cascade)
  sourceBill       Bill          @relation("SourceBill", fields: [sourceBillId], references: [id], onDelete: Cascade)

  @@unique([sourceBillId, companionBillId])
  @@index([sourceBillId])
  @@index([companionBillId])
}

model ExecutiveOrder {
  id                 String             @id @default(cuid())
  orderNumber        Int                @unique
  executiveOrderType ExecutiveOrderType
  title              String
  signingDate        DateTime
  publicationDate    DateTime?
  fullText           String?
  fullTextUrl        String?
  federalRegisterUrl String?
  presidentName      String
  sourceUrl          String?
  lastFetchedAt      DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  summaries          Summary[]
  categories         Category[]         @relation("ExecutiveOrderCategories")

  @@index([signingDate])
  // Added composite index for stable ordered pagination (date + id)
  @@index([signingDate, id])
}

model Summary {
  id               String          @id @default(cuid())
  billId           String?
  executiveOrderId String?
  summaryType      SummaryType
  content          String
  keyPoints        String[]
  impactAreas      String[]
  aiModel          String
  confidence       Float?
  generatedAt      DateTime        @default(now())
  reviewed         Boolean         @default(false)
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bill             Bill?           @relation(fields: [billId], references: [id])
  executiveOrder   ExecutiveOrder? @relation(fields: [executiveOrderId], references: [id])

  @@index([billId])
  @@index([executiveOrderId])
}

model Category {
  id              String           @id @default(cuid())
  name            String           @unique
  slug            String           @unique
  description     String?
  parentId        String?
  color           String?
  icon            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Category[]       @relation("CategoryHierarchy")
  bills           Bill[]           @relation("BillCategories")
  executiveOrders ExecutiveOrder[] @relation("ExecutiveOrderCategories")
}

model Member {
  id               String       @id @default(cuid())
  bioguideId       String       @unique
  firstName        String
  lastName         String
  fullName         String
  chamber          Chamber
  state            String
  district         Int?
  party            String
  termStart        DateTime
  termEnd          DateTime?
  imageUrl         String?
  websiteUrl       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sponsoredBills   Bill[]       @relation("Sponsored")
  votes            MemberVote[]
  cosponsoredBills Bill[]       @relation("Cosponsored")

  @@index([bioguideId])
}

model Vote {
  id              String       @id @default(cuid())
  rollCallNumber  Int
  chamber         Chamber
  congress        Int
  session         Int
  voteDate        DateTime
  voteQuestion    String
  voteResult      String
  yesVotes        Int
  noVotes         Int
  presentVotes    Int
  notVotingCount  Int
  billId          String?
  sourceUrl       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  individualVotes MemberVote[]
  bill            Bill?        @relation(fields: [billId], references: [id])

  @@unique([congress, chamber, rollCallNumber])
}

model MemberVote {
  id       String       @id @default(cuid())
  voteId   String
  memberId String
  position VotePosition
  member   Member       @relation(fields: [memberId], references: [id])
  vote     Vote         @relation(fields: [voteId], references: [id])

  @@unique([voteId, memberId])
}

model Amendment {
  id              String    @id @default(cuid())
  amendmentNumber String
  amendmentType   String
  congress        Int
  purpose         String?
  description     String?
  status          String
  statusDate      DateTime?
  billId          String
  sponsorId       String?
  proposedDate    DateTime
  sourceUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bill            Bill      @relation(fields: [billId], references: [id])

  @@unique([congress, amendmentType, amendmentNumber])
}

model Action {
  id         String   @id @default(cuid())
  billId     String
  actionDate DateTime
  actionCode String?
  actionType String
  text       String
  createdAt  DateTime @default(now())
  bill       Bill     @relation(fields: [billId], references: [id])

  @@index([billId, actionDate])
}

model User {
  id                      String         @id @default(cuid())
  email                   String         @unique
  username                String?        @unique
  passwordHash            String?
  name                    String?
  emailVerified           Boolean        @default(false)
  notificationPreferences Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  subscriptions           Subscription[]
  // Relations
  notificationPreference  NotificationPreference?
  billTrackings           BillTracking[]
  notifications           Notification[]
}

model NotificationPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  notifyOnStatusChange Boolean @default(true)
  notifyOnAllActions   Boolean @default(false)
  emailNotifications   Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BillTracking {
  id        String   @id @default(cuid())
  userId    String
  billId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([userId, billId])
  @@index([userId])
  @@index([billId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  viaEmail   Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Subscription {
  id               String                @id @default(cuid())
  userId           String
  subscriptionType SubscriptionType
  categoryIds      String[]
  keywords         String[]
  memberIds        String[]
  frequency        NotificationFrequency
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id])

  @@index([userId])
}

model JobRun {
  id             String    @id @default(cuid())
  jobName        String
  status         JobStatus
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  itemsProcessed Int       @default(0)
  itemsFailed    Int       @default(0)
  error          String?
  metadata       Json?

  @@index([jobName, startedAt])
}

/// Durable dead-letter table for items that repeatedly fail LLM processing.
model DeadLetter {
  id                String   @id @default(cuid())
  payload           Json
  errorMessage      String?
  attempts          Int      @default(0)
  billId            String?
  executiveOrderId  String?
  createdAt         DateTime @default(now())
  lastAttemptAt     DateTime?
  processed         Boolean  @default(false)
  processedAt       DateTime?

  @@index([billId])
  @@index([executiveOrderId])
  @@index([processed, createdAt])
}

enum BillStatus {
  INTRODUCED
  REFERRED_TO_COMMITTEE
  REPORTED_BY_COMMITTEE
  PASSED_HOUSE
  PASSED_SENATE
  RESOLVING_DIFFERENCES
  PRESENTED_TO_PRESIDENT
  BECAME_LAW
  VETOED
  FAILED
}

enum CompanionType {
  IDENTICAL
  RELATED
  SUPERSEDED
}

enum ExecutiveOrderType {
  EXECUTIVE_ORDER
  PRESIDENTIAL_MEMORANDUM
  PROCLAMATION
  DETERMINATION
}

enum SummaryType {
  BRIEF
  STANDARD
  DETAILED
  ELI5
  KEY_CHANGES
}

enum Chamber {
  HOUSE
  SENATE
}

enum VotePosition {
  YEA
  NAY
  PRESENT
  NOT_VOTING
}

enum SubscriptionType {
  ALL_BILLS
  SPECIFIC_CATEGORIES
  KEYWORD_MATCH
  MEMBER_ACTIVITY
  EXECUTIVE_ORDERS
}

enum NotificationFrequency {
  INSTANT
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
