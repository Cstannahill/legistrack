CREATE OR REPLACE FUNCTION get_bills(
  offset_val INT DEFAULT 0,
  limit_val INT DEFAULT 50,
  p_status public."BillStatus" DEFAULT NULL,
  p_category_slug TEXT DEFAULT NULL,
  p_congress INT DEFAULT NULL,
  p_search TEXT DEFAULT NULL,
  p_sort_field TEXT DEFAULT 'introducedDate',   -- allowed: introducedDate, updatedAt, statusDate
  p_sort_dir TEXT DEFAULT 'desc'                -- allowed: asc, desc
)
RETURNS TABLE (
  id TEXT,
  kind TEXT,
  "billType" TEXT,
  "billNumber" TEXT,
  congress INT,
  title TEXT,
  "currentStatus" public."BillStatus",
  sort_date TIMESTAMP,
  "presidentName" TEXT,
  categories JSONB,
  sponsor JSONB,
  total_count BIGINT
)
LANGUAGE plpgsql
AS $$
DECLARE
  sort_col TEXT;
  sort_direction TEXT;
BEGIN
  -- Whitelist sort field
  IF p_sort_field = 'updatedAt' THEN
    sort_col := 'updatedAt';
  ELSIF p_sort_field = 'statusDate' THEN
    sort_col := 'statusDate';
  ELSE
    sort_col := 'introducedDate';
  END IF;

  -- Whitelist direction
  IF lower(p_sort_dir) = 'asc' THEN
    sort_direction := 'ASC';
  ELSE
    sort_direction := 'DESC';
  END IF;

  RETURN QUERY
  EXECUTE format($fmt$
    WITH filtered AS (
      SELECT
        b.id::text,
        'bill'::text AS kind,
        b."billType"::text AS "billType",
        b."billNumber"::text AS "billNumber",
        b."congress"::int AS congress,
        b.title::text AS title,
        b."currentStatus"::public."BillStatus" AS "currentStatus",
        CASE 
			WHEN %I = 'statusDate' AND b."statusDate" IS NOT NULL THEN b."statusDate"
  			WHEN %I = 'updatedAt' AND b."updatedAt" IS NOT NULL THEN b."updatedAt"
  			ELSE b."introducedDate"
		END::timestamp AS sort_date,
		
        NULL::text AS "presidentName",
        b.id::text AS stable_id,
        COALESCE(
          (
            SELECT jsonb_agg(jsonb_build_object('id', c.id, 'name', c.name, 'slug', c.slug))
            FROM public.\"_BillCategories\" bc
            JOIN public.\"Category\" c ON c.id = bc.\"B\"
            WHERE bc.\"A\" = b.id
          ),
          '[]'::jsonb
        ) AS categories,
        (
          SELECT jsonb_build_object(
            'id', m.id,
            'fullName', m.\"fullName\",
            'bioguideId', m.\"bioguideId\",
            'party', m.\"party\",
            'state', m.\"state\"
          )
          FROM public.\"Member\" m
          WHERE m.id = b.\"sponsorId\"
          LIMIT 1
        ) AS sponsor
      FROM public.\"Bill\" b
      WHERE b.\"fullText\" IS NOT NULL
        AND EXISTS (
          SELECT 1 FROM public.\"Summary\" s
          WHERE s.\"billId\" = b.id
            AND s.\"content\" IS NOT NULL
        )
        AND ( $1::public.\"BillStatus\" IS NULL OR b.\"currentStatus\" = $1 )
        AND ( $2::TEXT IS NULL OR EXISTS (
              SELECT 1 FROM public.\"_BillCategories\" bc2
              JOIN public.\"Category\" c2 ON c2.id = bc2.\"B\"
              WHERE bc2.\"A\" = b.id AND c2.slug = $2
            ))
        AND ( $3::INT IS NULL OR b.\"congress\" = $3 )
        AND ( $4::TEXT IS NULL OR (
              b.title ILIKE '%%' || $4 || '%%'
              OR b.\"officialTitle\" ILIKE '%%' || $4 || '%%'
              OR b.\"shortTitle\" ILIKE '%%' || $4 || '%%'
            ))
    )\n
    SELECT
      f.id,
      f.kind,
      f.\"billType\",
      f.\"billNumber\",
      f.congress,
      f.title,
      f.\"currentStatus\",
      f.sort_date,
      f.\"presidentName\",
      f.categories,
      f.sponsor,
      COUNT(*) OVER()::bigint AS total_count
    FROM filtered f
    ORDER BY f.sort_date %s NULLS LAST, f.kind, f.stable_id
    OFFSET $5
    LIMIT $6
  $fmt$, sort_col, sort_col, sort_direction )
  USING p_status, p_category_slug, p_congress, p_search, offset_val, limit_val;
END;
$$;